<section id=3D"animate" style=3D"padding-bottom:3rem;">
  <div class=3D"section-label">03 =C2=B7 Step-by-Step Animator</div>
  <h2 class=3D"section-title">Watch the<br>Trace Happen</h2>
  <p class=3D"section-desc">Press <strong style=3D"color:var(--accent);">Ne=
xt Step</strong> to execute the algorithm one line at a time and watch the =
trace table build in real time.</p>

  <!-- PROGRAM SELECT -->
  <div style=3D"display:flex; gap:0.75rem; margin-bottom:1.5rem; flex-wrap:=
wrap;" class=3D"fade-in visible">
    <button class=3D"btn btn-outline" id=3D"prog0" style=3D"border-color:va=
r(--accent); color:var(--accent);">Program A: FOR Loop</button>
    <button class=3D"btn btn-outline" id=3D"prog1">Program B: Swap Variable=
s</button>
    <button class=3D"btn btn-outline" id=3D"prog2">Program C: Nested Logic<=
/button>
  </div>

  <div class=3D"animator-panel fade-in visible">
    <div class=3D"animator-header">
